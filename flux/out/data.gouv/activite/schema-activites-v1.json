          "type": "object"
        }
      },
      "required": [
        "codeNature",
        "caracteristiquesSpecifiques"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "codeNature": {
              "const": "AASA"
            },
            "caracteristiquesSpecifiques": {
