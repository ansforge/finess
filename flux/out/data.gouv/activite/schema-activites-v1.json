{
  "$id": "https://finess.fr/activite.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Activite",
  "description": "Schéma JSON du flux Activités, incluant toutes les activités publiables rattachées aux structures publiées",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Version du schéma utilisée pour générer le fichier."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage de génération du fichier au format ISO 8601."
    },
    "pmej": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "numFiness": {
            "$ref": "#/definitions/finessId"
          },
          "pmSmsseId": {
            "type": "string"
          },
          "activitesAutorisees": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/activiteAutorisee"
            }
          },
          "ege": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "egeId": {
                  "type": "string"
                },
                "numFinessEge": {
                  "$ref": "#/definitions/finessId"
                },
                "activitesExercees": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/activiteExercee"
                  }
                }
              },
              "required": [
                "egeId",
                "numFinessEge"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "numFiness",
          "pmSmsseId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "pmej"
  ],
  "additionalProperties": false,
  "definitions": {
    "finessId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{9}$",
      "description": "Numéro FINESS alphanumérique sur 9 caractères"
    },
    "activiteBase": {
      "type": "object",
      "properties": {
        "caracteristiquesGeneriques": {
          "$ref": "#/definitions/caracteristiquesGeneriques"
        },
        "nature": {
          "$ref": "#/definitions/natureActivite"
        }
      },
      "required": [
        "caracteristiquesGeneriques",
        "nature"
      ],
      "additionalProperties": false
    },
    "activiteAutorisee": {
      "allOf": [
        {
          "$ref": "#/definitions/activiteBase"
        },
        {
          "properties": {
            "caracteristiquesGeneriques": {
              "type": "object",
              "properties": {
                "pmSmsseExploitanteId": {
                  "type": "string",
                  "description": "Identifiant interne de la PMEJ exploitante (pmSmsseId)"
                }
              }
            }
          }
        }
      ]
    },
    "activiteExercee": {
      "allOf": [
        {
          "$ref": "#/definitions/activiteBase"
        },
        {
          "properties": {
            "caracteristiquesGeneriques": {
              "type": "object",
              "properties": {
                "identifiantAutorisation": {
                  "type": "string"
                },
                "egeId": {
                  "type": "string"
                },
                "egeExploitanteId": {
                  "type": "string",
                  "description": "Identifiant de l’EGE exploitante"
                },
                "egeFacturante": {
                  "type": "string",
                  "enum": [
                    "O",
                    "N"
                  ],
                  "description": "Indique si l'EGE est facturante (O/N)"
                }
              },
              "required": [
                "identifiantAutorisation",
                "egeId"
              ]
            }
          }
        }
      ]
    },
    "caracteristiquesGeneriques": {
      "type": "object",
      "properties": {
        "activiteAeId": {
          "type": "string"
        },
        "etatObjet": {
          "type": "string",
          "coding": {
            "system": "https://mos.esante.gouv.fr/NOS/tre_r386-macro-etat-objet-administratif/FHIR/tre-r386-macro-etat-objet-administratif"
          }
        },
        "identifiantAutorisation": {
          "type": "string"
        },
        "numAutorisationArhgos": {
          "type": "string"
        },
        "dateDebutActiviteAutorisee": {
          "type": "string"
        },
        "dateFinActiviteAutorisee": {
          "type": "string"
        },
        "dateFinEffectiveActivite": {
          "type": "string"
        },
        "dateCaduciteAutorisation": {
          "type": "string"
        },
        "engagementId": {
          "type": "string"
        },
        "egeId": {
          "type": "string"
        },
        "typeActiviteSMSSE": {
          "type": "string",
          "coding": {
            "system": "https://mos.esante.gouv.fr/NOS/tre_r392-type-act-smsse-regulee/FHIR/tre-r392-type-act-smsse-regulee"
          }
        }
      },
      "required": [
        "activiteAeId",
        "etatObjet",
        "dateDebutActiviteAutorisee",
        "typeActiviteSMSSE"
      ],
      "additionalProperties": false
    },
    "natureActivite": {
      "type": "object",
      "properties": {
        "codeNature": {
          "type": "string",
          "enum": [
            "AASA",
            "ASR",
            "EML",
            "ASDR",
            "ASOCR",
            "AMSR",
            "AER",
            "AMF",
